# =============================================================
# SIGPAR - Plantilla de variables de entorno (SIN claves reales)
# Copie este archivo como ".env" para trabajar en local.
# En Render estas variables se cargan en el panel (Environment).
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).
# =============================================================

# --- Base de datos MySQL ---
# Local (XAMPP/MySQL):  DB_HOST=127.0.0.1  DB_PORT=3306  DB_USER=root  DB_PASS=(su clave)
# Aiven:                copie host, puerto, usuario y clave del panel de Aiven
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sigpar
DB_USER=root
DB_PASS=
# Certificado SSL (Aiven lo exige). Puede ser la ruta a ca.pem o el contenido completo del certificado.
DB_SSL_CA=
# Reutilizar la conexión a MySQL entre peticiones (más rápido con Aiven). Déjelo en true.
DB_PERSISTENT=true

# --- Seguridad ---
# Cadena larga y aleatoria (mínimo 32 caracteres). Ej.: openssl rand -hex 32
JWT_SECRET=cambie-esto-por-una-clave-larga-y-aleatoria-0123456789
JWT_HOURS=12

# Superadministrador que se crea solo la primera vez (cambie la clave al entrar)
ADMIN_EMAIL=admin@sigpar.co
ADMIN_PASSWORD=Sigpar2026*
# Solo si el superadministrador olvidó su clave: true + reiniciar → la clave vuelve a ADMIN_PASSWORD. Luego vuelva a false.
ADMIN_RESET=false

# Orígenes permitidos para CORS (la web está en el mismo dominio, no hace falta).
# La app Android NO necesita CORS.
ALLOWED_ORIGINS=

# Cargar sedes y datos de ejemplo la primera vez (true/false). En producción: false.
DEMO_DATA=true

# --- Correos (opcional): avisos de vencimiento a abonados vía Brevo ---
BREVO_API_KEY=
MAIL_FROM=no-reply@tudominio.com

# --- IA (opcional): leer una foto o boceto del parqueadero y proponer el plano ---
# Sin clave, el editor ofrece igual el asistente por descripción y la foto como calco.
# Cada lectura consume créditos de la cuenta de Anthropic (console.anthropic.com).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
