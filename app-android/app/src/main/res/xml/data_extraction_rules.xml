<?xml version="1.0" encoding="utf-8"?>
<!-- La sesión (token cifrado con una llave del Keystore) no se copia a la nube ni a otro celular:
     en otro dispositivo no se podría descifrar y además es información sensible. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
